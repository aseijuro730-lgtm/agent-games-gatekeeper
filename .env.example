# Copy to .env or export these variables. NEVER commit real secrets.
# The server reads the HMAC secret from the env var first, else from the
# 0600 file at data/hmac-secret (re-read per request, no restart needed).
PORT=8787
# AGENT_GAMES_HMAC_SECRET=<paste-the-one-time-secret-from-agent-registration>
# HMAC_SECRET_FILE=./data/hmac-secret
# DATA_DIR=./data
# TASKID_ENCODING=utf8   # utf8 | keccak | numeric (string task_id -> field element)
# PROOF_TIMEOUT_MS=45000
